{
  "name": "blogcms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "羽衣甘蓝博客管理工具 —— 产品级本地/远程管理后台（React + MUI + Express）",
  "engines": {
    "node": ">=18"
